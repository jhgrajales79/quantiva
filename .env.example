# Autenticación (Auth.js)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base de datos (Postgres vía Vercel Marketplace / Neon)
DATABASE_URL=

# Proveedores de datos financieros
FMP_API_KEY=
FRED_API_KEY=
# CoinGecko free tier no requiere API key para los endpoints públicos usados

# Cron jobs (Vercel Cron envía este valor automáticamente como
# "Authorization: Bearer <CRON_SECRET>" cuando la variable existe)
CRON_SECRET=
